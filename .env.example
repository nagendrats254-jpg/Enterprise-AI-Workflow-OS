# ==============================================================
# Enterprise AI Workflow OS — Frontend Environment Configuration
# ==============================================================
# Copy this file to .env.local for local overrides.

# Optional: Custom backend API URL. Leave blank in local dev to use Vite proxy (/api)
# In production (e.g. Vercel), set this to your deployed backend URL:
# VITE_API_URL=https://enterprise-ai-api.onrender.com/api
VITE_API_URL=

# Real-time WebSocket server URL
# In local development: http://localhost:3001
# In production: https://enterprise-ai-api.onrender.com
VITE_SOCKET_URL=http://localhost:3001
